{
  "name": "amicooked",
  "version": "0.1.11",
  "description": "Ask your AI if you're cooked. A local MCP server for D2L Brightspace: grades, deadlines and announcements in Claude, ChatGPT and Gemini.",
  "type": "module",
  "bin": {
    "amicooked": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync:skill": "node scripts/sync-skill.mjs",
    "build": "node scripts/sync-skill.mjs && node scripts/clean-dist.mjs && tsc",
    "test": "vitest run && npm run test:gemini && npm run test:updates && npm run test:updates:native && npm run test:video -- --ci",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "build:bin": "node scripts/sync-skill.mjs && node scripts/build-binaries.mjs",
    "preversion": "npm test",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "stats": "node --env-file-if-exists=.env.local scripts/stats.mjs",
    "test:gemini": "node scripts/test-gemini.mjs",
    "pretest": "npm run build",
    "test:updates": "node scripts/test-updates.mjs",
    "test:updates:native": "node scripts/test-updates.mjs --build-native && node scripts/test-installer.mjs",
    "test:video": "node scripts/test-video-runtime.mjs"
  },
  "keywords": [
    "mcp",
    "d2l",
    "brightspace",
    "students",
    "claude",
    "chatgpt",
    "gemini"
  ],
  "author": "Uday Singh Kanwar",
  "contributors": [
    "Hamza Ammar (https://github.com/hamzakammar)",
    "Bence Redmond (https://github.com/General-Mudkip)",
    "alanxue1 (https://github.com/alanxue1)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udaysinghkanwar/amicooked.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
